# ---------------------------------------------------------------------------
# Copy to `.env` and edit. Used by docker-compose.yml.
#
#   cp .env.docker.example .env      (Linux/macOS)
#   copy .env.docker.example .env    (Windows)
#
# .env is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# ---- Web ------------------------------------------------------------------
# Host port to publish the site on. Use 80 for a plain http:// domain, or map
# to 8080 and put a reverse proxy / HTTPS in front of it.
WEB_PORT=80

# The address students type into their browser. This is also embedded in
# reminder email links, so it must be correct and public.
CLIENT_URL=http://localhost

# ---- Database -------------------------------------------------------------
# Any long random string. Do not reuse this anywhere else.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=classhub
POSTGRES_USER=postgres

# ---- API ------------------------------------------------------------------
# Must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d

MAX_FILE_SIZE_MB=10

# ---- Email ----------------------------------------------------------------
# Leave EMAIL_HOST and EMAIL_USER empty to run in capture mode: emails are
# rendered, logged to the container output and stored in the database, but not
# delivered. Set them to send for real.
#
#   Gmail      smtp.gmail.com          587  false   (use an App Password)
#   Office365  smtp.office365.com      587  false   (465 -> true)
#   SendGrid   smtp.sendgrid.net       587  false
#   Mailgun    smtp.mailgun.org        587  false
#
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=ClassHub <no-reply@classhub.edu>

# ---- Reminders ------------------------------------------------------------
REMINDER_CRON=*/10 * * * *
REMINDER_LEAD_HOURS=24
REMINDER_TOLERANCE_MINUTES=30
REMINDER_TZ=UTC
