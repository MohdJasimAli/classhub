# ---------------------------------------------------------------------------
# ClassHub - environment template
#
# Copy this file to `server/.env` (for the API) and `client/.env` (for the SPA)
# and fill in real values. NEVER commit a real .env file.
#
#   cp .env.example server/.env
#   cp .env.example client/.env
# ---------------------------------------------------------------------------

# ----------------------------- Database -----------------------------------
# Prisma / PostgreSQL connection string used by the API server.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/classhub"

# ----------------------------- Application --------------------------------
NODE_ENV="development"
PORT=5000

# Public URL of the React client. Used for CORS and for building the
# "Open Quiz" / "Open Assignment" deep links inside reminder emails.
CLIENT_URL="http://localhost:5173"

# ----------------------------- Authentication ------------------------------
# Generate a strong secret with:  openssl rand -base64 48
# or:                      node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ----------------------------- Email (SMTP) -------------------------------
# When EMAIL_HOST is left empty the server falls back to a "capture"
# transport: emails are logged to the console and persisted to the
# `EmailLog` table instead of being sent. This keeps local development
# fully functional without SMTP credentials.
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="ClassHub <no-reply@classhub.edu>"

# ----------------------------- File uploads --------------------------------
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB="10"

# ----------------------------- Rate limiting -------------------------------
RATE_LIMIT_WINDOW_MINUTES="15"
AUTH_RATE_LIMIT_MAX="20"

# ----------------------------- Scheduled jobs ------------------------------
# Cron expression for the deadline reminder sweep (default: every 10 minutes).
# The sweep is idempotent, so running it more often is always safe.
REMINDER_CRON="*/10 * * * *"

# How far ahead of a last date the reminder is sent, in hours. Default = 24.
REMINDER_LEAD_HOURS="24"

# Tolerance window around the target lead time. Prevents a last date from
# slipping through the gap between two ticks, without warning far too early.
REMINDER_TOLERANCE_MINUTES="30"

# ----------------------------- Testing -------------------------------------
# Optional: a separate PostgreSQL database that the automated test-suite uses so
# that running tests never touches your development data. If omitted, the suite
# derives it from DATABASE_URL by appending "_test" to the database name.
DATABASE_TEST_URL="postgresql://postgres:your_password@localhost:5432/classhub_test"
